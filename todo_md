def parse_version_from_source(source: str) -> str | None:
    m = re.search(r'^VERSION\s*=\s*["\x27]([^"\x27]+)["\x27]', source, flags=re.MULTILINE)
    return m.group(1) if m else None


def version_tuple(v: str) -> tuple[int, ...]:
    return tuple(int(p) for p in re.split(r"[^0-9]+", v) if p)


def fetch_remote_script(url: str | None = None) -> str:
    target_url = url or os.environ.get("TODO_MD_UPDATE_URL") or DEFAULT_UPDATE_URL
    req = urllib.request.Request(target_url, headers={"User-Agent": f"todo_md/{VERSION}"})
    with urllib.request.urlopen(req, timeout=15) as resp:
        data = resp.read().decode("utf-8")
    if REPO_MARKER not in data:
        raise ValueError(f"remote file at {target_url} is not a valid vitalio/todo_md script")
    return data


def cmd_check_update(url: str | None = None) -> int:
    prog = prog_name()
    try:
        remote_src = fetch_remote_script(url)
    except Exception as exc:
        sys.stderr.write(f"{prog}: failed to check for updates: {exc}\n")
        return 1
    remote_ver = parse_version_from_source(remote_src) or "unknown"
    if version_tuple(remote_ver) > version_tuple(VERSION):
        sys.stdout.write(f"{prog}: update available: {VERSION} -> {remote_ver} (run '{prog} update')\n")
    else:
        sys.stdout.write(f"{prog} {VERSION} is up to date (remote: {remote_ver}).\n")
    return 0


def cmd_update(force: bool = False, url: str | None = None, target_path: Path | None = None) -> int:
    prog = prog_name()
    dest = target_path or Path(__file__).resolve()
    try:
        remote_src = fetch_remote_script(url)
    except Exception as exc:
        sys.stderr.write(f"{prog}: update failed: {exc}\n")
        return 1
    remote_ver = parse_version_from_source(remote_src) or "unknown"
    if not force and version_tuple(remote_ver) <= version_tuple(VERSION):
        sys.stdout.write(f"{prog} {VERSION} is already up to date.\n")
        return 0
    try:
        tmp_fd, tmp_name = tempfile.mkstemp(prefix=f".{dest.name}.", dir=str(dest.parent))
        try:
            with os.fdopen(tmp_fd, "w", encoding="utf-8") as f:
                f.write(remote_src)
            os.chmod(tmp_name, 0o755)
            os.replace(tmp_name, dest)
        except Exception:
            if os.path.exists(tmp_name):
                os.unlink(tmp_name)
            raise
    except Exception as exc:
        sys.stderr.write(f"{prog}: could not write updated binary to {dest}: {exc}\n")
        return 1
    sys.stdout.write(f"{prog}: updated {VERSION} -> {remote_ver} ({dest})\n\n")
    sys.stdout.write(f"=== Updated AI Agent Instructions ({prog} v{remote_ver}) ===\n\n")
    sys.stdout.flush()
    subprocess.run([str(dest), "agents"], check=False)
    return 0


def _extract_and_remove_task(text: str, target_id: str) -> tuple[dict[str, object] | None, str]:
    lines = text.splitlines()
    in_fence = False
    start_idx: int | None = None
    end_idx: int | None = None
    found_info: dict[str, object] | None = None
    for idx, line in enumerate(lines):
        if line.lstrip().startswith(FENCE):
            in_fence = not in_fence
        if not in_fence:
            if start_idx is not None and (line.startswith("### ") or line.startswith("## ")):
                end_idx = idx
                break
            if start_idx is None and line.startswith("### "):
                m = HEADING_RE.match(line)
                if m and m.group(3).upper() == target_id:
                    emoji, status, tid, title = m.groups()
                    start_idx = idx
                    found_info = {"id": tid, "status": status, "emoji": emoji, "title": title}
    if start_idx is None or found_info is None:
        return None, text
    if end_idx is None:
        end_idx = len(lines)
    section_lines = lines[start_idx:end_idx]
    while section_lines and not section_lines[-1].strip():
        section_lines.pop()
    found_info["lines"] = section_lines
    remaining = lines[:start_idx] + lines[end_idx:]
    new_text = re.sub(r"\n{3,}", "\n\n", "\n".join(remaining).rstrip()) + "\n"
    return found_info, new_text


def _format_heading(status: str, tid: str, title: str, note: str | None = None) -> str:
    emoji = VALID_STATUSES[status]
    clean_title = title.strip()
    if note:
        clean_title = re.sub(r"\s+—\s+\*.*\*\s*$", "", clean_title)
        clean_title = f"{clean_title} — *{note.strip()}*"
    return f"### {emoji} [{status}] {tid}: {clean_title}"


def _append_task_section(file_path: Path, section_lines: list[str], default_header: str) -> None:
    if not file_path.is_file():
        file_path.write_text(default_header + "\n\n" + "\n".join(section_lines) + "\n", encoding="utf-8")
        return
    existing = file_path.read_text(encoding="utf-8").rstrip()
    file_path.write_text(existing + "\n\n" + "\n".join(section_lines) + "\n", encoding="utf-8")


def _parse_note_arg(rest: list[str]) -> tuple[list[str], str | None]:
    pos: list[str] = []
    note: str | None = None
    i = 0
    while i < len(rest):
        if rest[i] in ("-m", "--note", "--reason"):
            if i + 1 >= len(rest):
                raise SystemExit(f"{prog_name()}: {rest[i]} requires an argument")
            note = rest[i + 1]
            i += 2
        else:
            pos.append(rest[i])
            i += 1
    return pos, note


def cmd_archive_view(base_dir: Path) -> int:
    arch_path = base_dir / "TODO_ARCHIVE.md"
    if not arch_path.is_file():
        sys.stderr.write(f"{prog_name()}: no TODO_ARCHIVE.md found in {base_dir}\n")
        return 1
    sys.stdout.write(read_if_exists(arch_path).rstrip() + "\n")
    return 0


def cmd_transition(
    base_dir: Path,
    task_id: str,
    new_status: str | None = None,
    dest_file: str | None = None,
    note: str | None = None,
) -> int:
    target = task_id.strip().upper()
    if new_status and new_status not in VALID_STATUSES:
        raise SystemExit(f"{prog_name()}: invalid status {new_status!r}; expected one of {', '.join(VALID_STATUSES)}")
    source_file: str | None = None
    found: dict[str, object] | None = None
    updated_source_text = ""
    for fname in TASK_FILES:
        p = base_dir / fname
        if not p.is_file():
            continue
        info, rem = _extract_and_remove_task(read_if_exists(p), target)
        if info is not None:
            source_file = fname
            found = info
            updated_source_text = rem
            break
    if found is None or source_file is None:
        sys.stderr.write(f"{prog_name()}: task {target!r} not found in TODO*.md under {base_dir}\n")
        return 1

    final_status = new_status or str(found["status"])
    if dest_file is None:
        if final_status in ("DONE", "CANCELED"):
            dest_file = "TODO_ARCHIVE.md"
        else:
            dest_file = source_file

    sec_lines = list(found["lines"])  # type: ignore[arg-type]
    sec_lines[0] = _format_heading(final_status, str(found["id"]), str(found["title"]), note=note)

    if dest_file == source_file:
        src_path = base_dir / source_file
        orig_lines = read_if_exists(src_path).splitlines()
        in_fence = False
        for idx, line in enumerate(orig_lines):
            if line.lstrip().startswith(FENCE):
                in_fence = not in_fence
            if not in_fence and line.startswith("### "):
                m = HEADING_RE.match(line)
                if m and m.group(3).upper() == target:
                    orig_lines[idx] = sec_lines[0]
                    break
        src_path.write_text("\n".join(orig_lines) + "\n", encoding="utf-8")
        sys.stdout.write(f"{prog_name()}: updated {target} -> [{final_status}] in {source_file}\n")
        return 0

    (base_dir / source_file).write_text(updated_source_text, encoding="utf-8")
    default_hdrs = {
        "TODO.md": "# Project — active tasks and operational state\n\n## Tasks",
        "TODO_PLAN.md": "# Project — deferred tasks and future roadmap\n\n## Deferred Tasks",
        "TODO_ARCHIVE.md": "# Project — archived tasks (DONE and CANCELED)\n\n## Archive",
    }
    _append_task_section(base_dir / dest_file, sec_lines, default_hdrs[dest_file])
    sys.stdout.write(f"{prog_name()}: moved {target} ([{final_status}]) from {source_file} -> {dest_file}\n")
    return 0


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    prog = prog_name()
    if "-h" in args or "--help" in args or (args and args[0] == "help"):
        sys.stdout.write(usage_text())
        return 0
    if "-V" in args or "--version" in args or (args and args[0] == "version"):
        sys.stdout.write(f"{prog} {VERSION}\n")
        return 0
    if args and args[0] in ("agents", "--agents", "--agents-md"):
        sys.stdout.write(agents_markdown(prog) + "\n")
        return 0
    if args and args[0] in ("check-update", "--check-update"):
        return cmd_check_update()
    if args and args[0] in ("update", "--update", "--self-update"):
        force = "--force" in args[1:]
        return cmd_update(force=force)

    explicit_dir: str | None = None
    if args and args[0] not in ("plan", "archive", "done", "cancel", "canceled", "status", "activate", "defer", "ids", "check", "init", "list", "show", "agents", "update", "check-update", "help", "version") and not args[0].startswith("-") and Path(args[0]).is_dir():
        explicit_dir = args.pop(0)
    base_dir = resolve_target_dir(explicit_dir)
    if not args:
        return cmd_summary(base_dir, include_plan=False)
    if args[0] in ("plan", "--plan", "-p"):
        return cmd_summary(base_dir, include_plan=True)
    if args[0] in ("archive", "--archive", "-a"):
        pos, note = _parse_note_arg(args[1:])
        canceled = "--canceled" in pos or "--cancel" in pos
        pos = [p for p in pos if p not in ("--canceled", "--cancel", "--done")]
        if not pos:
            return cmd_archive_view(base_dir)
        return cmd_transition(base_dir, pos[0], new_status=("CANCELED" if canceled else "DONE"), dest_file="TODO_ARCHIVE.md", note=note)
    if args[0] in ("done", "--done"):
        pos, note = _parse_note_arg(args[1:])
        if len(pos) != 1:
            raise SystemExit(f"{prog}: usage: {prog} done <ID> [-m NOTE]")
        return cmd_transition(base_dir, pos[0], new_status="DONE", dest_file="TODO_ARCHIVE.md", note=note)
    if args[0] in ("cancel", "canceled", "--cancel"):
        pos, note = _parse_note_arg(args[1:])
        if len(pos) != 1:
            raise SystemExit(f"{prog}: usage: {prog} cancel <ID> [-m REASON]")
        return cmd_transition(base_dir, pos[0], new_status="CANCELED", dest_file="TODO_ARCHIVE.md", note=note)
    if args[0] in ("status", "--status"):
        pos, note = _parse_note_arg(args[1:])
        if len(pos) != 2:
            raise SystemExit(f"{prog}: usage: {prog} status <ID> <STATUS> [-m NOTE]")
        return cmd_transition(base_dir, pos[0], new_status=pos[1].upper(), dest_file=None, note=note)
    if args[0] in ("activate", "--activate"):
        wip = "--wip" in args[1:]
        pos = [a for a in args[1:] if a != "--wip"]
        if len(pos) != 1:
            raise SystemExit(f"{prog}: usage: {prog} activate <ID> [--wip]")
        return cmd_transition(base_dir, pos[0], new_status=("WIP" if wip else "NEW"), dest_file="TODO.md")
    if args[0] in ("defer", "--defer"):
        if len(args) != 2:
            raise SystemExit(f"{prog}: usage: {prog} defer <ID>")
        return cmd_transition(base_dir, args[1], new_status="NEW", dest_file="TODO_PLAN.md")
    if args[0] in ("ids", "--ids"):
        return cmd_ids(base_dir)
    if args[0] in ("check", "--check"):
        return cmd_check(base_dir)
    if args[0] in ("init", "--init"):
        force = "--force" in args[1:]
        return cmd_init(base_dir, force=force)
    if args[0] in ("list", "--list", "-l"):
        filt = args[1] if len(args) > 1 else None
        return cmd_list(base_dir, filt)
    if args[0] in ("show", "--show"):
        if len(args) != 2:
            raise SystemExit(f"{prog}: usage: {prog} show <ID>")
        return cmd_show(base_dir, args[1])
    if len(args) == 1 and re.fullmatch(r"[A-Za-z]\d+", args[0]):
        return cmd_show(base_dir, args[0])
    if len(args) == 1 and Path(args[0]).is_dir():
        return cmd_summary(resolve_target_dir(args[0]), include_plan=False)
    raise SystemExit(f"{prog}: unknown arguments: {' '.join(args)} (see {prog} --help)")


if __name__ == "__main__":
    raise SystemExit(main())
