#!/usr/bin/env python3
# todo_md-repo: vitalio/todo_md
"""Usage:
  {prog} [dir]                               Print summary (TODO.md + IDs in use + plan/archive counts)
  {prog} <ID> | show <ID>                    Show full section for task <ID> across TODO*.md
  {prog} list [filter]                       Compact task table (active | plan | archive | all | <STATUS>)
  {prog} plan                                Print summary plus full TODO_PLAN.md
  {prog} archive [<ID>] [-m NOTE]            Print TODO_ARCHIVE.md, or archive task <ID>
  {prog} add [<ID|PREFIX>] <TITLE> [opts]    Add a new task (reads body from -b TEXT or stdin)
                                             Opts: --plan, --status STATUS, -m NOTE, -b BODY
  {prog} edit <ID> [opts]                    Update task title, note, or body (-t TITLE, -m NOTE, -b BODY or stdin)
  {prog} append <ID> [-b TEXT]               Append text to task <ID> body (from -b TEXT or stdin)
  {prog} status <ID> <STATUS> [-m NOTE]      Update status of <ID> (NEW|WIP|HOLD|QUESTION|DONE|CANCELED)
  {prog} activate <ID> [--wip]               Move task <ID> from TODO_PLAN.md into active TODO.md
  {prog} defer <ID>                          Move task <ID> from active TODO.md into TODO_PLAN.md
  {prog} done <ID> [-m SHA_OR_NOTE]          Mark task <ID> as DONE and move it to TODO_ARCHIVE.md
  {prog} cancel <ID> [-m REASON]             Mark task <ID> as CANCELED and move it to TODO_ARCHIVE.md
  {prog} resume [-b TEXT]                    Replace ## Resume section in TODO.md (from -b TEXT or stdin)
  {prog} ids                                 Print highest task IDs in use and next available ID per prefix
  {prog} check                               Validate layout, headings, status badges, and unique IDs
  {prog} init [--force]                      Create starter TODO.md, TODO_PLAN.md, and TODO_ARCHIVE.md
  {prog} --agents | agents                   Print Markdown instructions for AI agents
  {prog} update [--force]                    Self-update {prog} from GitHub (vitalio/todo_md)
  {prog} check-update                        Check if a newer version is available on GitHub
  {prog} -V | --version                      Print version and exit 0
  {prog} -h | --help                         Print this usage and exit 0

Manages structured Markdown task files in a repository:
  - TODO.md          Operational state (Resume) and immediate/active tasks
  - TODO_PLAN.md     Deferred/future tasks and open design questions
  - TODO_ARCHIVE.md  Completed (DONE) and dropped (CANCELED) tasks and historical snapshots

Environment variables:
  TODO_MD_CWD          Override target directory (default: current directory or Git root)
  TODO_MD_UPDATE_URL   Override raw script URL for update / check-update
"""
from __future__ import annotations

if __doc__ is None:
    raise SystemExit("missing usage documentation")

import os
import re
import subprocess
import sys
import tempfile
import urllib.request
from datetime import date
from pathlib import Path

VERSION = "0.2.0"
REPO_MARKER = "todo_md-repo: vitalio/todo_md"
DEFAULT_UPDATE_URL = "https://raw.githubusercontent.com/vitalio/todo_md/main/todo_md"
FENCE = chr(96) * 3

VALID_STATUSES: dict[str, str] = {
    "NEW": "⚪",
    "WIP": "🔵",
    "HOLD": "⏸️",
    "QUESTION": "❓",
    "DONE": "✅",
    "CANCELED": "❌",
}

TASK_FILES = ("TODO.md", "TODO_PLAN.md", "TODO_ARCHIVE.md")

HEADING_RE = re.compile(
    r"^###\s+(⚪|🔵|⏸️?|❓|✅|❌)\s+`?\[(NEW|WIP|HOLD|QUESTION|DONE|CANCELED)\]`?\s+([A-Z]\d+)\s*:\s*(.+?)\s*$"
)
STATUS_TOKEN_PAT = r"(?:(?:⚪|🔵|⏸️?|❓|✅|❌)\s+)?`?\[(?:NEW|WIP|HOLD|QUESTION|DONE|CANCELED)\]`?"
ANY_ID_RE = re.compile(
    rf"^(?:###\s+(?:{STATUS_TOKEN_PAT}\s+|[-*o?+c]\s+)?|(?:- \[[ xX~]\]\s+(?:{STATUS_TOKEN_PAT}\s+)?|- |[*o?+c] ))([A-Z]\d+)\b"
)


def prog_name() -> str:
    raw = Path(sys.argv[0]).name if sys.argv and sys.argv[0] else "todo_md"
    for suf in (".py", ".cmd", ".bat", ".exe"):
        if raw.lower().endswith(suf) and len(raw) > len(suf):
            raw = raw[:-len(suf)]
            break
    return raw or "todo_md"


def usage_text() -> str:
    return (__doc__ or "").format(prog=prog_name())


def resolve_target_dir(explicit: str | None = None) -> Path:
    if explicit:
        p = Path(explicit).expanduser().resolve()
        if not p.is_dir():
            raise SystemExit(f"{prog_name()}: directory not found: {explicit}")
        return p
    env_cwd = os.environ.get("TODO_MD_CWD", "").strip()
    if env_cwd:
        return Path(env_cwd).expanduser().resolve()
    cwd = Path.cwd().resolve()
    if (cwd / "TODO.md").is_file():
        return cwd
    try:
        r = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=str(cwd),
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            check=False,
        )
        if r.returncode == 0 and r.stdout.strip():
            groot = Path(r.stdout.strip()).resolve()
            if (groot / "TODO.md").is_file():
                return groot
    except OSError:
        pass
    return cwd


def read_if_exists(path: Path) -> str:
    return path.read_text(encoding="utf-8", errors="replace") if path.is_file() else ""


def _read_stdin_if_piped() -> str | None:
    try:
        if not sys.stdin.isatty():
            data = sys.stdin.read()
            return data if data.strip() else None
    except Exception:
        pass
    return None


def parse_tasks_in_text(text: str, filename: str) -> list[dict[str, object]]:
    tasks: list[dict[str, object]] = []
    in_fence = False
    current: dict[str, object] | None = None
    body_lines: list[str] = []
    for lineno, line in enumerate(text.splitlines(), start=1):
        if line.lstrip().startswith(FENCE):
            in_fence = not in_fence
        if not in_fence:
            if line.startswith("### ") or line.startswith("## "):
                if current is not None:
                    current["section"] = "\n".join(body_lines).rstrip()
                    tasks.append(current)
                    current = None
                    body_lines = []
                if line.startswith("### "):
                    m = HEADING_RE.match(line)
                    if m:
                        emoji, status, tid, title = m.groups()
                        current = {
                            "id": tid,
                            "status": status,
                            "emoji": emoji,
                            "title": title,
                            "file": filename,
                            "line": lineno,
                            "heading": line,
                        }
                        body_lines = [line]
                        continue
        if current is not None:
            body_lines.append(line)
    if current is not None:
        current["section"] = "\n".join(body_lines).rstrip()
        tasks.append(current)
    return tasks


def collect_all_tasks(base_dir: Path) -> list[dict[str, object]]:
    all_tasks: list[dict[str, object]] = []
    for fname in TASK_FILES:
        p = base_dir / fname
        if p.is_file():
            all_tasks.extend(parse_tasks_in_text(read_if_exists(p), fname))
    return all_tasks


def highest_ids_in_use(base_dir: Path) -> dict[str, int]:
    top: dict[str, int] = {}
    for fname in TASK_FILES:
        text = read_if_exists(base_dir / fname)
        if not text:
            continue
        in_fence = False
        for line in text.splitlines():
            if line.lstrip().startswith(FENCE):
                in_fence = not in_fence
                continue
            if in_fence:
                continue
            m = ANY_ID_RE.match(line)
            if m:
                ident = m.group(1)
                prefix, num = ident[0], int(ident[1:])
                top[prefix] = max(top.get(prefix, 0), num)
    return top


def all_used_ids(base_dir: Path) -> set[str]:
    used: set[str] = set()
    for fname in TASK_FILES:
        text = read_if_exists(base_dir / fname)
        if not text:
            continue
        in_fence = False
        for line in text.splitlines():
            if line.lstrip().startswith(FENCE):
                in_fence = not in_fence
                continue
            if in_fence:
                continue
            m = ANY_ID_RE.match(line)
            if m:
                used.add(m.group(1).upper())
    return used


def next_free_id(base_dir: Path, prefix: str = "F") -> str:
    p = prefix.upper()
    if not re.fullmatch(r"[A-Z]", p):
        raise SystemExit(f"{prog_name()}: invalid ID prefix {prefix!r}; expected a single letter A-Z")
    top = highest_ids_in_use(base_dir)
    return f"{p}{top.get(p, 0) + 1}"


def format_ids_summary(top: dict[str, int]) -> str:
    if not top:
        return "[none]"
    used = " ".join(f"{k}:{v}" for k, v in sorted(top.items()))
    nxt = ", ".join(f"{k}{v + 1}" for k, v in sorted(top.items()))
    return f"{used}  (next free: {nxt})"


def cmd_summary(base_dir: Path, include_plan: bool = False) -> int:
    todo_path = base_dir / "TODO.md"
    if not todo_path.is_file():
        sys.stderr.write(f"{prog_name()}: no TODO.md found in {base_dir} (run '{prog_name()} init' to create one)\n")
        return 1
    todo_text = read_if_exists(todo_path).rstrip()
    sys.stdout.write(todo_text + "\n\n")
    top = highest_ids_in_use(base_dir)
    plan_tasks = parse_tasks_in_text(read_if_exists(base_dir / "TODO_PLAN.md"), "TODO_PLAN.md")
    arch_tasks = parse_tasks_in_text(read_if_exists(base_dir / "TODO_ARCHIVE.md"), "TODO_ARCHIVE.md")
    sys.stdout.write("---\n")
    sys.stdout.write(f"IDs in use: {format_ids_summary(top)}\n")
    sys.stdout.write(f"Deferred in TODO_PLAN.md: {len(plan_tasks)} task(s) | Archived in TODO_ARCHIVE.md: {len(arch_tasks)} task(s)\n")
    if include_plan and (base_dir / "TODO_PLAN.md").is_file():
        plan_text = read_if_exists(base_dir / "TODO_PLAN.md").rstrip()
        sys.stdout.write(f"\n===== TODO_PLAN.md =====\n{plan_text}\n")
    return 0


def cmd_ids(base_dir: Path) -> int:
    top = highest_ids_in_use(base_dir)
    sys.stdout.write(f"IDs in use: {format_ids_summary(top)}\n")
    return 0


def cmd_show(base_dir: Path, task_id: str) -> int:
    target = task_id.strip().upper()
    for t in collect_all_tasks(base_dir):
        if str(t["id"]).upper() == target:
            sys.stdout.write(f"# {t['file']}:{t['line']}\n{t['section']}\n")
            return 0
    sys.stderr.write(f"{prog_name()}: task {target!r} not found in TODO*.md under {base_dir}\n")
    return 1


def cmd_list(base_dir: Path, filt: str | None = None) -> int:
    mode = (filt or "active").strip().lower()
    tasks = collect_all_tasks(base_dir)
    if mode == "active":
        shown = [t for t in tasks if t["file"] == "TODO.md"]
    elif mode == "plan":
        shown = [t for t in tasks if t["file"] == "TODO_PLAN.md"]
    elif mode == "archive":
        shown = [t for t in tasks if t["file"] == "TODO_ARCHIVE.md"]
    elif mode == "all":
        shown = tasks
    elif mode.upper() in VALID_STATUSES:
        shown = [t for t in tasks if t["status"] == mode.upper()]
    else:
        raise SystemExit(f"{prog_name()}: unknown list filter {filt!r}; expected active, plan, archive, all, or a status name")

    if not shown:
        sys.stdout.write(f"No matching tasks ({mode}) in {base_dir}\n")
    else:
        for t in shown:
            badge = f"{t['emoji']} [{t['status']}]"
            loc = str(t["file"])
            sys.stdout.write(f"  {str(t['id']):<6}  {badge:<14}  {loc:<16}  {t['title']}\n")
    top = highest_ids_in_use(base_dir)
    sys.stdout.write(f"\nIDs in use: {format_ids_summary(top)}\n")
    return 0


def validate_all(base_dir: Path) -> tuple[list[str], int]:
    errors: list[str] = []
    seen_ids: dict[str, str] = {}
    has_archive = (base_dir / "TODO_ARCHIVE.md").is_file()
    for fname in TASK_FILES:
        p = base_dir / fname
        if not p.is_file():
            continue
        text = read_if_exists(p)
        in_fence = False
        h2_titles: list[str] = []
        in_tasks_sec = False
        in_task_item = False
        for lineno, line in enumerate(text.splitlines(), start=1):
            if line.lstrip().startswith(FENCE):
                in_fence = not in_fence
                continue
            if in_fence:
                continue
            if line.startswith("## "):
                sec_name = line[3:].strip()
                h2_titles.append(sec_name)
                in_tasks_sec = sec_name in ("Tasks", "Deferred Tasks", "Archive")
                in_task_item = False
                continue
            if in_tasks_sec and not in_task_item and line.strip() and not line.startswith("### "):
                errors.append(f"{fname}:{lineno}: unexpected content outside a '###' task section: {line}")
            if line.startswith("### "):
                in_task_item = True
                m = HEADING_RE.match(line)
                if not m:
                    errors.append(f"{fname}:{lineno}: invalid task heading format: {line}")
                    continue
                emoji, status, tid, title = m.groups()
                norm_emoji = "⏸️" if emoji.startswith("⏸") else emoji
                if VALID_STATUSES.get(status) != norm_emoji:
                    errors.append(f"{fname}:{lineno}: mismatched emoji {emoji} for status [{status}]")
                if title.endswith(",") or title.count("(") != title.count(")"):
                    errors.append(f"{fname}:{lineno}: truncated/malformed task heading title: {title!r}")
                loc = f"{fname}:{lineno}"
                if tid in seen_ids:
                    errors.append(f"{loc}: duplicate task ID {tid} (first seen at {seen_ids[tid]})")
                else:
                    seen_ids[tid] = loc
                if fname in ("TODO.md", "TODO_PLAN.md") and has_archive and status in ("DONE", "CANCELED"):
                    errors.append(f"{loc}: {status} task {tid} should be moved to TODO_ARCHIVE.md")
                if fname == "TODO_ARCHIVE.md" and status not in ("DONE", "CANCELED"):
                    errors.append(f"{loc}: non-archived status [{status}] on task {tid} in TODO_ARCHIVE.md")
        if fname == "TODO.md" and h2_titles != ["Resume", "Tasks"]:
            errors.append(f"{fname}: expected H2 sections ['Resume', 'Tasks'], found {h2_titles}")
        if fname == "TODO_PLAN.md" and h2_titles != ["Deferred Tasks"]:
            errors.append(f"{fname}: expected H2 section ['Deferred Tasks'], found {h2_titles}")
        if fname == "TODO_ARCHIVE.md" and "Archive" not in h2_titles:
            errors.append(f"{fname}: missing '## Archive' H2 section, found {h2_titles}")
    return errors, len(seen_ids)


def cmd_check(base_dir: Path) -> int:
    errors, count = validate_all(base_dir)
    if errors:
        for e in errors:
            sys.stderr.write(f"ERROR: {e}\n")
        return 1
    sys.stdout.write(f"{prog_name()}: OK ({count} task(s) verified across TODO*.md)\n")
    return 0


def cmd_init(base_dir: Path, force: bool = False) -> int:
    today = date.today().isoformat()
    templates = {
        "TODO.md": "\n".join([
            "# Project — active tasks and operational state",
            "",
            "`README.md` documents usage; `AGENTS.md` sets the rules for an AI agent.",
            "Deferred tasks live in `TODO_PLAN.md`; completed and canceled records live in `TODO_ARCHIVE.md`.",
            "",
            "Task heading format: `### <emoji> [<STATUS>] <ID>: <title>`",
            "(`⚪ [NEW]`, `🔵 [WIP]`, `⏸️ [HOLD]`, `❓ [QUESTION]`, `✅ [DONE]`, `❌ [CANCELED]`).",
            "",
            "## Resume",
            "",
            f"Written {today}. Initialized TODO structure.",
            "",
            "## Tasks",
            "",
            "### ⚪ [NEW] F1: Initial task",
            "",
            "Describe the goal and acceptance criteria.",
            "",
        ]),
        "TODO_PLAN.md": "\n".join([
            "# Project — deferred tasks and future roadmap",
            "",
            "Active operational tasks live in `TODO.md`; completed and canceled records live in `TODO_ARCHIVE.md`.",
            "",
            "## Deferred Tasks",
            "",
        ]),
        "TODO_ARCHIVE.md": "\n".join([
            "# Project — archived tasks (DONE and CANCELED)",
            "",
            "Active operational tasks live in `TODO.md`; deferred tasks live in `TODO_PLAN.md`.",
            "",
            "## Archive",
            "",
        ]),
    }
    created: list[str] = []
    for fname, content in templates.items():
        p = base_dir / fname
        if p.exists() and not force:
            continue
        p.write_text(content, encoding="utf-8")
        created.append(fname)
    if not created:
        sys.stdout.write(f"{prog_name()}: TODO*.md files already exist in {base_dir} (use --force to overwrite)\n")
    else:
        sys.stdout.write(f"{prog_name()}: initialized {', '.join(created)} in {base_dir}\n")
    return 0


